# Python bytecode files
*.pyc

# Project-level shared VLA datasets and fine-tuned checkpoints are intentionally
# local artifacts. Keep only the layout documentation in git.
/datasets/*
!/datasets/README.md

/artifacts/*
!/artifacts/checkpoints/
/artifacts/checkpoints/*
!/artifacts/checkpoints/README.md

# Local environment files
cookies.txt

# output/ is the local eval & analysis workspace. Keep the runner scripts,
# analysis generators and the comparison figures, but never version the
# transient run/eval logs they produce.
output/eval/logs/
output/**/*.log