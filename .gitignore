# IDE / Editor directories
.vscode/
.claude/

# Byte-compiled / optimized / DLL files
__pycache__/

# Project-level shared VLA datasets and fine-tuned checkpoints are intentionally
# local artifacts. Keep only the layout documentation in git.
/datasets/*
!/datasets/README.md

/artifacts/*
!/artifacts/checkpoints/
/artifacts/checkpoints/*
!/artifacts/checkpoints/README.md

/tmp/

# Automation pipeline: local config (may hold LAN credentials), runtime state, logs, reports
/config.yaml
/scripts/pipeline/config.yaml
/pipeline_state.json
/logs/
/report_*.html