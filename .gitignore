# IDE / Editor directories
.vscode/
.claude/

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc

# Project-level shared VLA datasets and fine-tuned checkpoints are intentionally
# local artifacts. Keep only the layout documentation in git.
/datasets/*
!/datasets/README.md

/artifacts/*
!/artifacts/checkpoints/
/artifacts/checkpoints/*
!/artifacts/checkpoints/README.md

/tmp/

# Automation pipeline: local config (may hold LAN credentials)
/config.yaml
/agents/vla-trainbot/harness/config/config.yaml

# Per-agent runtime workspace (state, logs, reports, eval recordings) — never versioned.
# agents/agentbot has its own repo/.gitignore for its var/.
agents/*/var/

# Local environment files
cookies.txt
