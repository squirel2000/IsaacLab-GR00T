<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="diagram" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="roll" value="&lt;b&gt;1. Rollout&lt;/b&gt;&lt;br/&gt;policy 在 LIBERO&lt;br/&gt;互動蒐集軌跡" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8effd;strokeColor=#2f6fd0;fontColor=#1b2330;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="170" height="74" as="geometry"/></mxCell>
