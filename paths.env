# =============================================================================
# paths.env — bash mirror of workspace.yaml. Source it to get WS_* variables:
#
#   source "$(dirname "${BASH_SOURCE[0]}")/paths.env"   # from a root script
#
# or, from anywhere inside the workspace, walk up to the root first:
#
#   d="$(pwd)"; while [ "$d" != "/" ] && [ ! -f "$d/workspace.yaml" ]; do d="$(dirname "$d")"; done
#   source "$d/paths.env"
#
# All values are derived from workspace.yaml — do NOT hardcode paths here.
# =============================================================================

# Root = directory containing this file (paths.env sits next to workspace.yaml).
WS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WS_ROOT

_ws_get() { awk -F': *' -v k="$1" '!/^[[:space:]]*#/ && $1==k {print $2; exit}' "$WS_ROOT/workspace.yaml"; }

export WS_AGENTBOT="$WS_ROOT/$(_ws_get agentbot)"
export WS_EVAL_HARNESS="$WS_ROOT/$(_ws_get eval_harness)"
export WS_VLA_HARNESS="$WS_ROOT/$(_ws_get vla_harness)"

export WS_ISAAC_GR00T="$WS_ROOT/$(_ws_get isaac_gr00t)"
export WS_N1D7="$WS_ROOT/$(_ws_get isaac_gr00t_n1d7)"
export WS_STARVLA="$WS_ROOT/$(_ws_get starvla)"
export WS_VLM_REPO="$WS_ROOT/$(_ws_get isaac_gr00t_vlm)"
export WS_ISAACLAB="$WS_ROOT/$(_ws_get isaaclab)"
export WS_OPENARM_ROS2="$WS_ROOT/$(_ws_get openarm_ros2)"
export WS_OPENARM_TELEOP="$WS_ROOT/$(_ws_get openarm_teleop)"

export WS_COMMON_TOOLS="$WS_ROOT/$(_ws_get common_tools)"

export WS_DATASETS="$WS_ROOT/$(_ws_get datasets)"
export WS_ARTIFACTS="$WS_ROOT/$(_ws_get artifacts)"
export WS_GR00T_CKPTS="$WS_ROOT/$(_ws_get gr00t_checkpoints)"

unset -f _ws_get
